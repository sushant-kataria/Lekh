-- build.lekh: the Lekh website, generated by a Lekh program.
--
--   python3 lekh.py site/build.lekh            writes the site to site/dist/
--   python3 lekh.py site/build.lekh some/dir   writes it somewhere else
--
-- Run it from the project folder. It reads the Markdown in docs/ and the
-- data in site/content/, turns it into HTML with the Markdown converter and
-- highlighter in site/lib/, runs the example programs to show their real
-- output, and copies the files in site/static/ (styles, script, icons).
use escape_html, slug_of from "lib/html"
use render, inline, code_block, Rendered, Heading from "lib/markdown"
use highlight from "lib/highlight"
use Page, render_page, relative, logo_svg, GITHUB from "lib/layout"
use TAGLINE, PITCH, FEATURES, Feature from "content/home"
use EXAMPLES, Example from "content/examples"

constant STATIC be "site/static"
constant SNIPPETS be "site/content/snippets"

-- ---------------------------------------------------------------- helpers

to read_or_stop path as text gives text:
    when read_file of path:
        is ok t: give back t
        is problem why: fail "The site build needs {path}, but: {why}"

to write_page out as text, p as Page, version as text:
    let path be join_path with out, p's path
    make_folder of (folder_of of path)
    when write_file with path, render_page with p, version:
        is ok n: say "  wrote {p's path}"
        is problem why: fail "Couldn't write {path}: {why}"

-- the Python that runs Lekh programs during the build (LEKH_PYTHON can change it)
to python_command gives text:
    give back (environment of "LEKH_PYTHON") or else "python3"

-- run a Lekh program and give back everything it printed
to run_lekh file as text gives text:
    when run_command of "{run python_command} lekh.py run {file}":
        is ok r:
            let all be r's output + r's errors
            give back trim_end of (replace with all, "{SNIPPETS}/", "")
        is problem why: fail "Couldn't run {file}: {why}"

-- "a/b/../c" -> "a/c"
to normalize path as text gives text:
    let changeable parts be empty list
    for each piece in split with path, "/":
        if piece is "" or piece is ".": skip
        if piece is "..":
            let dropped be take last from parts
            skip
        add piece to parts
    give back join with parts, "/"

-- Where should a link in a Markdown file point on the site?
--   other docs  -> their page here     (docs/safety.md -> safety.html)
--   examples/   -> the Examples page
--   other files -> the file on GitHub  (DESIGN.md, LICENSE, a .lekh file)
to fix_link url as text, source as text, here as text, pages as map of text to text gives text:
    if url starts with "http" or url starts with "mailto:" or url starts with "#": give back url
    let bits be split with url, "#"
    let anchor be if length of bits is greater than 1 then "#" + item 2 of bits otherwise ""
    let repo_path be normalize of (join_path with (folder_of of source), item 1 of bits)
    when pages at repo_path:
        is some target: give back (relative with here, target) + anchor
        is nothing:
            if repo_path is "examples": give back relative with here, "examples.html"
            let kind be if is_folder of repo_path then "tree" otherwise "blob"
            give back "{GITHUB}/{kind}/main/{repo_path}{anchor}"

to when_ok_or r as result of CommandOutput or text gives text:
    when r:
        is ok out: give back out's output
        is problem why: give back "Lekh"

-- render one Markdown file as it would appear at `here` on the site
to render_doc source_path as text, markdown as text, here as text, pages as map of text to text gives Rendered:
    give back render with markdown, given url: fix_link with url, source_path, here, pages

to toc_html headings as list of Heading, title as text gives text:
    let items be turn each h in headings into "<li class=\"toc-{h's level}\"><a href=\"#{h's id}\">{escape_html of h's title}</a></li>"
    give back "<nav class=\"toc\" aria-label=\"On this page\"><p class=\"toc-title\">{escape_html of title}</p><ul>{join with items, ""}</ul></nav>"

to doc_body r as Rendered, sidebar as text gives text:
    give back "<div class=\"wrap doc-layout\"><aside class=\"sidebar\">{sidebar}</aside><article class=\"prose\">{r's html}</article></div>"

-- ---------------------------------------------------------------- pages

to chapter_title r as Rendered, file as text gives text:
    if r's title is not "": give back r's title
    give back file

to home_page version as text, speedup as text gives Page:
    let compare_lekh be read_or_stop of "{SNIPPETS}/compare.lekh"
    let compare_rust be read_or_stop of "{SNIPPETS}/compare.rs"
    let compare_out be run_lekh of "{SNIPPETS}/compare.lekh"
    let error_code be read_or_stop of "{SNIPPETS}/error.lekh"
    let error_out be run_lekh of "{SNIPPETS}/error.lekh"
    let hello_code be read_or_stop of "{SNIPPETS}/hello.lekh"
    let hello_out be run_lekh of "{SNIPPETS}/hello.lekh"
    let changeable parts be empty list
    -- hero
    add "<section class=\"hero\"><div class=\"wrap hero-grid\"><div class=\"hero-text\">" to parts
    add "<p class=\"eyebrow\">{logo_svg with 22, "hero"} Lekh {escape_html of version} · open source · MIT</p>" to parts
    add "<h1>{escape_html of TAGLINE}</h1>" to parts
    add "<p class=\"lead\">{escape_html of PITCH}</p>" to parts
    add "<div class=\"cta-row\"><a class=\"button primary\" href=\"learn/index.html\">Start learning</a><a class=\"button\" href=\"{GITHUB}\" rel=\"noopener\">View on GitHub</a></div>" to parts
    add "<p class=\"install-line\"><code>git clone {GITHUB}.git</code></p></div>" to parts
    add "<div class=\"hero-code\">{code_block with (split with hello_code, "\n"), "lekh file=hello.lekh"}{code_block with (split with hello_out, "\n"), "output"}</div>" to parts
    add "</div></section>" to parts
    -- side by side
    add "<section class=\"band\"><div class=\"wrap\"><h2 class=\"section-title\">The same program, in Lekh and in Rust</h2>" to parts
    add "<p class=\"section-lead\">Lekh keeps Rust's safety ideas (results instead of exceptions, explicit borrowing) and writes them in words.</p>" to parts
    add "<div class=\"compare\"><div>{code_block with (split with compare_lekh, "\n"), "lekh file=bank.lekh"}{code_block with (split with compare_out, "\n"), "output"}</div><div>{code_block with (split with compare_rust, "\n"), "rust"}</div></div>" to parts
    add "</div></section>" to parts
    -- features
    add "<section><div class=\"wrap\"><h2 class=\"section-title\">Why Lekh?</h2><div class=\"features\">" to parts
    for each f in FEATURES:
        let changeable card be "<article class=\"feature\"><div class=\"feature-icon\" aria-hidden=\"true\">{escape_html of f's icon}</div><h3>{escape_html of f's title}</h3><p>{escape_html of f's blurb}</p>"
        if f's code is not "":
            change card to card + "<pre class=\"mini\"><code>{highlight with f's code, "lekh"}</code></pre>"
        if f's title is "Fast builds":
            change card to card + "<p class=\"big-number\">{escape_html of speedup}× <span>faster than the interpreter on the benchmark, with identical output</span></p>"
        add card + "</article>" to parts
    add "</div></div></section>" to parts
    -- a real error message
    add "<section class=\"band\"><div class=\"wrap two-col\"><div><h2 class=\"section-title\">Errors that teach</h2><p class=\"section-lead\">This program gives a list away and then tries to use it. Lekh stops before running anything and explains, in English, what went wrong and how to fix it. The message on the right is real: it was produced while this page was built.</p>{code_block with (split with error_code, "\n"), "lekh file=app.lekh"}</div>" to parts
    add "<div>{code_block with (split with error_out, "\n"), "output"}</div></div></section>" to parts
    -- install
    add "<section><div class=\"wrap two-col\"><div><h2 class=\"section-title\">Install in a minute</h2><p class=\"section-lead\">You need Python 3.8 or newer, and nothing else.</p>" to parts
    add "{code_block with (list of "git clone {GITHUB}.git", "cd Lekh", "python3 lekh.py run examples/hello.lekh", "python3 lekh.py repl"), "bash"}</div>" to parts
    add "<div><h2 class=\"section-title\">Then make a project</h2><p class=\"section-lead\">Projects come with a module, tests and a README.</p>{code_block with (list of "python3 lekh.py new my_app", "cd my_app", "python3 ../lekh.py run", "python3 ../lekh.py test"), "bash"}</div></div></section>" to parts
    -- call to action
    add "<section class=\"cta\"><div class=\"wrap cta-box\"><h2>Write your first sentence of code</h2><p>Read the 15-chapter guide, browse the examples, or star the project on GitHub.</p><div class=\"cta-row\"><a class=\"button primary\" href=\"learn/01-install.html\">Read chapter 1</a><a class=\"button\" href=\"{GITHUB}\" rel=\"noopener\">★ Star on GitHub</a></div></div></section>" to parts
    give back Page with path "index.html", title TAGLINE, section "home", description PITCH, body join with parts, "\n"

to examples_page gives Page:
    let changeable parts be list of "<div class=\"wrap narrow\"><header class=\"page-head\"><h1>Examples</h1><p class=\"section-lead\">Real Lekh programs from the <a href=\"{GITHUB}/tree/main/examples\" rel=\"noopener\">examples folder</a>. Each one was run while this site was built, and the output shown is what it printed.</p></header>"
    let toc be turn each ex in EXAMPLES into "<li><a href=\"#{slug_of of ex's title}\">{escape_html of ex's title}</a></li>"
    add "<ul class=\"chips\">{join with toc, ""}</ul>" to parts
    for each ex in EXAMPLES:
        let path be "examples/{ex's file}"
        say "  running {path}"
        let code be read_or_stop of path
        let output be run_lekh of path
        let lines_count be length of (lines of code)
        add "<section class=\"example\" id=\"{slug_of of ex's title}\"><h2>{escape_html of ex's title}</h2><p>{escape_html of ex's blurb} <a href=\"{GITHUB}/blob/main/{path}\" rel=\"noopener\">{ex's file}</a> · {lines_count} lines</p>" to parts
        add "<div class=\"example-grid\"><div class=\"scroll\">{code_block with (split with code, "\n"), "lekh file={ex's file}"}</div><div class=\"scroll\">{code_block with (split with output, "\n"), "output"}</div></div></section>" to parts
    add "</div>" to parts
    give back Page with path "examples.html", title "Examples", section "examples", description "Real Lekh programs and the output they print.", body join with parts, "\n"

-- ---------------------------------------------------------------- main

if not (file_exists of "lekh.py") or not (is_folder of "docs"):
    fail "Run the site build from the Lekh project folder:  python3 lekh.py site/build.lekh"

let args be arguments
let out be if length of args is greater than 0 then first of args otherwise "site/dist"
let started be now
say "Building the Lekh website into {out}/"
make_folder of out

-- the version number, asked from Lekh itself ("Lekh 0.2.0" -> "v0.2.0")
let version_text be when_ok_or of (run_command of "{run python_command} lekh.py version")
let version be "v" + (replace with (trimmed of version_text), "Lekh ", "")

-- the speed-up, read from the benchmark results
let bench be (read_file of "benchmarks/results.txt") or else ""
let found be find_groups with bench, "speed-up: ([0-9.]+)x"
let speedup be if length of found is 0 then "17" otherwise (whole of (((first of (first of found)) as number) or else 17)) as text

-- every Markdown file that becomes a page, and where it goes
let chapters be keep each f in ((list_folder of "docs/guide") or else (empty list)) where f ends with ".md" and f is not "README.md"
let changeable pages be map of "README.md" to "index.html", "docs/guide/README.md" to "learn/index.html", "docs/reference.md" to "reference.html", "docs/cheatsheet.md" to "cheatsheet.html", "docs/safety.md" to "safety.html", "docs/roadmap.md" to "about.html", "site/content/about.md" to "about.html"
for each f in chapters:
    change pages at "docs/guide/{f}" to "learn/" + (replace with f, ".md", ".html")

-- the static files: styles, script, icons, logo, and the banner for link previews
for each name in (list_folder of STATIC) or else (empty list):
    let copied be copy_file with (join_path with STATIC, name), join_path with out, name
let banner be copy_file with "assets/lekh-banner.png", join_path with out, "lekh-banner.png"
say "  copied the static files"

-- Home
write_page with out, (home_page with version, speedup), version

-- Learn: the guide index, the chapters (with a chapter list and previous/next links) and the safety guide
let changeable chapter_titles be empty list
for each f in chapters:
    let md be read_or_stop of "docs/guide/{f}"
    let r be render with md, given u: u
    add chapter_title with r, f to chapter_titles

to learn_sidebar chapters as list of text, titles as list of text, current as text gives text:
    let changeable items be empty list
    for each f and pos in chapters:
        let target be replace with f, ".md", ".html"
        let mark be if target is current then " aria-current=\"page\"" otherwise ""
        add "<li><a href=\"{target}\"{mark}>{escape_html of (item pos of titles)}</a></li>" to items
    let guide_mark be if current is "index.html" then " aria-current=\"page\"" otherwise ""
    give back "<nav class=\"toc\" aria-label=\"Guide chapters\"><p class=\"toc-title\"><a href=\"index.html\"{guide_mark}>The Lekh guide</a></p><ol class=\"chapters\">{join with items, ""}</ol><p class=\"toc-title\">More</p><ul><li><a href=\"../safety.html\">How Lekh keeps you safe</a></li><li><a href=\"../reference.html\">Reference</a></li><li><a href=\"../cheatsheet.html\">Cheat sheet</a></li></ul></nav>"

let guide_index be render_doc with "docs/guide/README.md", (read_or_stop of "docs/guide/README.md"), "learn/index.html", pages
let start_button be "<p class=\"cta-row\"><a class=\"button primary\" href=\"01-install.html\">Start with chapter 1 →</a></p>"
let guide_body be "<div class=\"wrap doc-layout\"><aside class=\"sidebar\">{learn_sidebar with chapters, chapter_titles, "index.html"}</aside><article class=\"prose\">{guide_index's html}{start_button}</article></div>"
write_page with out, (Page with path "learn/index.html", title "Learn Lekh", section "learn", description "A beginner's guide to Lekh in 15 short chapters.", body guide_body), version

for each f and pos in chapters:
    let here be "learn/" + (replace with f, ".md", ".html")
    let source be "docs/guide/{f}"
    -- the chapters end with a "Next: ..." line; the page has its own previous/next buttons instead
    let kept be keep each line in (split with (read_or_stop of source), "\n") where not (line starts with "Next: [")
    let r be render_doc with source, (join with kept, "\n"), here, pages
    let changeable pager be "<nav class=\"pager\" aria-label=\"Chapters\">"
    if pos is greater than 1:
        change pager to pager + "<a class=\"prev\" href=\"{replace with (item (pos - 1) of chapters), ".md", ".html"}\"><span>Previous</span>{escape_html of (item (pos - 1) of chapter_titles)}</a>"
    if pos is less than length of chapters:
        change pager to pager + "<a class=\"next\" href=\"{replace with (item (pos + 1) of chapters), ".md", ".html"}\"><span>Next</span>{escape_html of (item (pos + 1) of chapter_titles)}</a>"
    let body be "<div class=\"wrap doc-layout\"><aside class=\"sidebar\">{learn_sidebar with chapters, chapter_titles, replace with f, ".md", ".html"}</aside><article class=\"prose\">{r's html}{pager}</nav></article></div>"
    write_page with out, (Page with path here, title r's title, section "learn", description "{r's title}: a chapter of the Lekh guide.", body body), version

-- Reference, cheat sheet and the safety guide, each with an "on this page" list
for each (source, here, key, blurb) in list of ("docs/reference.md", "reference.html", "reference", "Every keyword, type, operator and built-in task in Lekh, with examples."), ("docs/cheatsheet.md", "cheatsheet.html", "cheatsheet", "The whole Lekh language on one page."), ("docs/safety.md", "safety.html", "learn", "How Lekh keeps programs safe: ownership, borrowing, maybe and result."):
    let r be render_doc with source, (read_or_stop of source), here, pages
    write_page with out, (Page with path here, title r's title, section key, description blurb, body doc_body with r, toc_html with r's headings, "On this page"), version

-- Examples, run for real
write_page with out, (run examples_page), version

-- About and roadmap on one page (the roadmap's headings move down one level)
let about be render_doc with "site/content/about.md", (read_or_stop of "site/content/about.md"), "about.html", pages
let roadmap_lines be turn each line in (split with (read_or_stop of "docs/roadmap.md"), "\n") into (if line starts with "#" then "#" + line otherwise line)
let roadmap be render_doc with "docs/roadmap.md", (join with roadmap_lines, "\n"), "about.html", pages
let about_headings be (list of (Heading with level 2, title "About Lekh", id "about-lekh")) + roadmap's headings
let about_body be "<div class=\"wrap doc-layout\"><aside class=\"sidebar\">{toc_html with about_headings, "On this page"}</aside><article class=\"prose\">{about's html}<hr>{roadmap's html}</article></div>"
write_page with out, (Page with path "about.html", title "About and roadmap", section "about", description "Who made Lekh, how this site is built, and an honest roadmap.", body about_body), version

-- a page for addresses that don't exist (GitHub Pages shows 404.html)
write_page with out, (Page with path "404.html", title "Page not found", section "", description "This page doesn't exist.", body "<div class=\"wrap narrow page-head\"><h1>This page doesn't exist</h1><p class=\"section-lead\">In Lekh terms: you asked for a page and got <code>nothing</code>.</p><p class=\"cta-row\"><a class=\"button primary\" href=\"index.html\">Go home</a></p></div>"), version

say "Done in {round with (seconds_since of started), 1} seconds."
