-- layout.lekh: the frame every page shares (head, navigation, footer).
-- All links are relative ("../reference.html"), so the site works in any
-- folder, such as https://sushant-kataria.github.io/Lekh/.
use escape_html from "html"

share constant GITHUB be "https://github.com/sushant-kataria/Lekh"
share constant SITE_URL be "https://sushant-kataria.github.io/Lekh/"

share record Page:
    path as text
    title as text
    section as text
    description as text
    body as text

-- "../" once for every folder the page is inside
share to prefix_for path as text gives text:
    give back repeat_text with "../", count_of with path, "/"

-- a link from the page at `here` to the site page `target`
share to relative here as text, target as text gives text:
    give back (prefix_for of here) + target

to nav_link here as text, active as text, key as text, target as text, label as text gives text:
    let current be if key is active then " aria-current=\"page\"" otherwise ""
    give back "<a href=\"{relative with here, target}\"{current}>{label}</a>"

-- `name` keeps the gradient ids apart when a page shows the logo more than once
share to logo_svg size as number, name as text gives text:
    give back "<svg class=\"logo\" width=\"{size}\" height=\"{size}\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><defs><linearGradient id=\"logo-{name}\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#16b8a5\"/><stop offset=\"1\" stop-color=\"#0b6b63\"/></linearGradient></defs><rect width=\"64\" height=\"64\" rx=\"15\" fill=\"url(#logo-{name})\"/><path d=\"M14 17.5 H50\" stroke=\"#fff\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M27 17.5 C27 28 24.5 37 22.5 44.5 C21.8 47.5 23.4 49.6 26.6 49 C32 48 37 47.2 41 47\" fill=\"none\" stroke=\"#fff\" stroke-width=\"5.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"49\" cy=\"46.6\" r=\"3.6\" fill=\"#ffd166\"/></svg>"

-- sets the colour theme before the page is drawn, so there is no flash
constant THEME_SCRIPT be "<script>(function(){{var t=localStorage.getItem('lekh-theme');if(t)document.documentElement.setAttribute('data-theme',t);}})();</script>"

share to render_page p as Page, version as text gives text:
    let up be prefix_for of p's path
    let here be p's path
    let full_title be if p's section is "home" then "Lekh: {p's title}" otherwise "{p's title} · Lekh"
    let changeable head be list of "<!doctype html>", "<html lang=\"en\">", "<head>", "<meta charset=\"utf-8\">", "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    add "<title>{escape_html of full_title}</title>" to head
    add "<meta name=\"description\" content=\"{escape_html of p's description}\">" to head
    add "<meta property=\"og:title\" content=\"{escape_html of full_title}\">" to head
    add "<meta property=\"og:description\" content=\"{escape_html of p's description}\">" to head
    add "<meta property=\"og:image\" content=\"{SITE_URL}lekh-banner.png\">" to head
    add "<meta name=\"twitter:card\" content=\"summary_large_image\">" to head
    add "<meta name=\"theme-color\" content=\"#0f9d8f\">" to head
    add "<link rel=\"icon\" href=\"{up}favicon.svg\" type=\"image/svg+xml\">" to head
    add "<link rel=\"icon\" href=\"{up}favicon.png\" type=\"image/png\" sizes=\"32x32\">" to head
    add "<link rel=\"apple-touch-icon\" href=\"{up}apple-touch-icon.png\">" to head
    add "<link rel=\"stylesheet\" href=\"{up}style.css\">" to head
    add THEME_SCRIPT to head
    add "</head>" to head
    let links be list of (nav_link with here, p's section, "learn", "learn/index.html", "Learn"), (nav_link with here, p's section, "reference", "reference.html", "Reference"), (nav_link with here, p's section, "cheatsheet", "cheatsheet.html", "Cheat sheet"), (nav_link with here, p's section, "examples", "examples.html", "Examples"), (nav_link with here, p's section, "about", "about.html", "About")
    let changeable top be list of "<body>", "<a class=\"skip\" href=\"#main\">Skip to content</a>", "<header class=\"site-header\"><div class=\"wrap header-row\">"
    add "<a class=\"brand\" href=\"{relative with here, "index.html"}\">{logo_svg with 30, "head"}<span>Lekh</span></a>" to top
    add "<nav class=\"site-nav\" aria-label=\"Main\">{join with links, ""}</nav>" to top
    add "<div class=\"header-tools\"><a class=\"gh\" href=\"{GITHUB}\" rel=\"noopener\" aria-label=\"Lekh on GitHub\">GitHub</a><button class=\"theme-toggle\" type=\"button\" aria-label=\"Switch between light and dark\"><span class=\"sun\">☀</span><span class=\"moon\">☾</span></button></div>" to top
    add "</div></header>" to top
    let footer be "<footer class=\"site-footer\"><div class=\"wrap footer-row\"><div class=\"footer-brand\">{logo_svg with 22, "foot"}<span>Lekh {escape_html of version}</span></div><p>This site was generated by a Lekh program: <a href=\"{GITHUB}/blob/main/site/build.lekh\" rel=\"noopener\">site/build.lekh</a>.</p><p><a href=\"{GITHUB}/blob/main/LICENSE\" rel=\"noopener\">MIT licence</a> · © 2026 Sushant Kataria · <a href=\"{GITHUB}\" rel=\"noopener\">GitHub</a></p></div></footer>"
    let script be "<script src=\"{up}site.js\" defer></script>"
    give back (join with head, "\n") + "\n" + (join with top, "\n") + "\n<main id=\"main\">\n" + p's body + "\n</main>\n" + footer + "\n" + script + "\n</body>\n</html>\n"
